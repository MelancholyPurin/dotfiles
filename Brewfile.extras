# Dev toolchains, apps, VS Code extensions and fun stuff.
# Install `brew bundle --file=Brewfile.extras`

# Taps
tap "ddev/ddev"
tap "nikolaeu/numi"

# Formulae
brew "automake"
brew "buf"
brew "cbonsai"
brew "clang-format"
brew "cmake"
brew "cmatrix"
brew "cmus"
brew "composer"
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "docker-credential-helper"
brew "fnm"
brew "fortune"
brew "gnuplot"
brew "go"
brew "gobject-introspection"
brew "googletest"
brew "gradle"
brew "icu4c@76"
brew "jansson"
brew "jpeg"
brew "libedit"
brew "make"
brew "mkcert"
brew "mole"
brew "mysql"
brew "neofetch"
brew "node"
brew "nss"
brew "nyancat"
brew "ollama"
brew "php@8.2"
brew "phpbrew"
brew "pipes-sh"
brew "protoc-gen-go"
brew "protoc-gen-go-grpc"
brew "python@3.10", link: false
brew "python@3.11", link: false
brew "python@3.13"
brew "rename"
brew "yt-dlp"
brew "yyjson"

# Apps
cask "discord"
cask "firefox"
cask "mactex"
cask "minecraft"
cask "obs"
cask "obsidian"
cask "openemu"
cask "orbstack"
cask "spotify"
cask "steam"
cask "thunderbird"
cask "vcv-rack"
cask "vlc"

